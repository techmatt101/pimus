{
    "name": "pimus-playground",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Local debug playground for the smartamp controller. Development only; never deployed to the Pi.",
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "build": "pnpm run clean && tsc",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist",
        "start": "pnpm run build && node dist/playground/src/main.mjs",
        "dev": "pnpm run build && pnpm run --parallel \"/^dev:/\"",
        "dev:compile": "tsc --watch --preserveWatchOutput",
        "dev:serve": "node --watch dist/playground/src/main.mjs"
    },
    "dependencies": {
        "@elgato-stream-deck/node": "7.6.3",
        "@julusian/jpeg-turbo": "3.0.1",
        "@napi-rs/canvas": "1.0.2",
        "usb": "2.18.0",
        "ws": "8.21.1"
    },
    "devDependencies": {
        "@types/node": "20.19.43",
        "@types/ws": "8.18.1",
        "typescript": "5.9.3"
    }
}
