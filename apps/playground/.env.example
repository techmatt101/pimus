# Credentials the playground uses to reach a real Home Assistant.
# Copy this file to apps/playground/.env and fill both in; .env is git-ignored.
# Values already set in your shell take precedence over this file.

# Base URL of your instance — the same one you open in a browser.
HOME_ASSISTANT_URL=http://homeassistant.local:8123

# A long-lived access token: Home Assistant profile -> Security -> Long-lived
# access tokens -> Create token.
HOME_ASSISTANT_TOKEN=paste-your-long-lived-token-here
