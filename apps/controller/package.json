{
  "name": "pimus-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "pnpm run clean && tsc && cp -R assets dist/assets",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "pnpm run build && node --test $(find dist/test -name '*.test.mjs' | sort)"
  },
  "dependencies": {
    "@elgato-stream-deck/node": "7.6.3",
    "@napi-rs/canvas": "1.0.2",
    "usb": "2.18.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  }
}
