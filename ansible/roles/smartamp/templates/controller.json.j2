{% set voice_ducking_enabled = (voice_assistant_enabled | bool) and (smartamp_voice_ducking_enabled | bool) %}
{
  "voice_enabled": {{ voice_assistant_enabled | bool | to_json }},
  "lva_uri": "ws://127.0.0.1:{{ voice_assistant_peripheral_port }}",
  "audio_socket": "/run/user/{{ smartamp_uid }}/smartamp-audio.sock",
  "ducking": {
    "enabled": {{ voice_ducking_enabled | to_json }}
  },
  "webhook_base": {{ home_assistant_webhook_base | to_json }},
  {# The key/dial layout is compiled into the controller (streamdeck/layout.mts);
     only whether this unit drives a deck is a deployment choice. #}
  "streamdeck": {
    "enabled": {{ streamdeck_enabled | bool | to_json }}
  },
  "respeaker": {
    "enabled": {{ respeaker_led_enabled | bool | to_json }},
    "vendor_id": 10374,
    "product_id": 26,
    "brightness": {{ respeaker_led_brightness | int }},
    "speed": 2,
    "states": {{ respeaker_led_states | to_nice_json }}
  }
}
