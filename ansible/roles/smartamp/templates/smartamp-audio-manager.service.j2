[Unit]
Description=Smart Amp PipeWire source router
After=user@{{ smartamp_uid }}.service smartamp-hifiberry.service
Requires=user@{{ smartamp_uid }}.service
Wants=smartamp-hifiberry.service

[Service]
Type=simple
User={{ smartamp_service_user }}
Group={{ smartamp_service_user }}
Environment=XDG_RUNTIME_DIR=/run/user/{{ smartamp_uid }}
Environment=PULSE_SERVER=/run/user/{{ smartamp_uid }}/pulse/native
# The manager parses English `pactl subscribe` lines; a localized pactl would
# silently disable event-driven reconciliation.
Environment=LC_ALL=C
# Remove the previous process's readiness file before starting. Consumers must
# wait for a fresh hardware scan instead of trusting stale device names.
ExecStartPre=/usr/bin/rm -f /run/user/{{ smartamp_uid }}/smartamp-audio-status.json
ExecStart={{ smartamp_app_dir }}/audio_manager.py --config {{ smartamp_config_dir }}/audio.json --socket /run/user/{{ smartamp_uid }}/smartamp-audio.sock --status /run/user/{{ smartamp_uid }}/smartamp-audio-status.json
Restart=always
RestartSec=3
# Apply a small, predictable isolation baseline without restricting the local
# PipeWire APIs the router needs to discover and switch audio devices.
# ProtectHome=true would also hide /run/user, where this service's socket,
# status file, and the PipeWire/PulseAudio sockets live; tmpfs mode allows
# BindPaths to mount the runtime directory back into the sandbox.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=tmpfs
BindPaths=/run/user/{{ smartamp_uid }}
ProtectSystem=full
UMask=0027

[Install]
WantedBy=multi-user.target
