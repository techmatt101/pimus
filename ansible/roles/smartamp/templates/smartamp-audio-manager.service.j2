[Unit]
Description=Smart Amp PipeWire source router
After=user@{{ smartamp_uid }}.service smartamp-hifiberry.service
Requires=user@{{ smartamp_uid }}.service
Wants=smartamp-hifiberry.service

[Service]
Type=simple
User={{ smartamp_service_user }}
Group={{ smartamp_service_user }}
Environment=XDG_RUNTIME_DIR=/run/user/{{ smartamp_uid }}
Environment=PULSE_SERVER=/run/user/{{ smartamp_uid }}/pulse/native
# Remove the previous process's readiness file before starting. Consumers must
# wait for a fresh hardware scan instead of trusting stale device names.
ExecStartPre=/usr/bin/rm -f /run/user/{{ smartamp_uid }}/smartamp-audio-status.json
ExecStart={{ smartamp_app_dir }}/audio_manager.py --config {{ smartamp_config_dir }}/audio.json --state {{ smartamp_state_dir }}/audio-state.json --status /run/user/{{ smartamp_uid }}/smartamp-audio-status.json --duck-state /run/user/{{ smartamp_uid }}/smartamp-audio-duck.json
Restart=always
RestartSec=3
# The router needs only its state/runtime directories and the local PipeWire
# socket; keep the OS and kernel-management surfaces read-only/inaccessible.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ smartamp_state_dir }} /run/user/{{ smartamp_uid }}
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
