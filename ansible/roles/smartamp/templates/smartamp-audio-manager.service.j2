[Unit]
Description=Smart Amp PipeWire source router
After=user@{{ smartamp_uid }}.service smartamp-hifiberry.service
Requires=user@{{ smartamp_uid }}.service
Wants=smartamp-hifiberry.service

[Service]
Type=simple
User={{ smartamp_service_user }}
Group={{ smartamp_service_user }}
Environment=XDG_RUNTIME_DIR=/run/user/{{ smartamp_uid }}
Environment=PULSE_SERVER=/run/user/{{ smartamp_uid }}/pulse/native
ExecStart={{ smartamp_app_dir }}/audio_manager.py --config {{ smartamp_config_dir }}/audio.json --state {{ smartamp_state_dir }}/audio-state.json --status /run/user/{{ smartamp_uid }}/smartamp-audio-status.json --duck-state /run/user/{{ smartamp_uid }}/smartamp-audio-duck.json
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
