[Unit]
Description=Initialise HiFiBerry DAC2 ADC Pro mixer
After=sound.target
Wants=sound.target

[Service]
Type=oneshot
ExecStart={{ smartamp_app_dir }}/hifiberry-init.sh
RemainAfterExit=yes
# Apply a small isolation baseline. ProtectSystem=full still allows ALSA to
# update its state under /var while keeping installed system files read-only.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0027

[Install]
WantedBy=multi-user.target
