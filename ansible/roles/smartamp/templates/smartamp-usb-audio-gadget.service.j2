[Unit]
Description=Smart Amp USB Audio Class 2 gadget
After=systemd-modules-load.service sys-kernel-config.mount
Before=smartamp-audio-manager.service

[Service]
Type=oneshot
ExecStart={{ smartamp_app_dir }}/usb-audio-gadget.sh start
ExecStop={{ smartamp_app_dir }}/usb-audio-gadget.sh stop
RemainAfterExit=yes
# Apply the same small isolation baseline while leaving the root service's
# module-loading, mount, and configfs access available for USB gadget setup.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
# This is the only root service; retain just the two capabilities used by
# modprobe and the optional configfs mount.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_MODULE
UMask=0027

[Install]
WantedBy=multi-user.target
