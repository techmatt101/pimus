{% set voice_ducking_enabled = (voice_assistant_enabled | bool) and (smartamp_voice_ducking_enabled | bool) %}
{
  "output_match": {{ smartamp_output_match | to_json }},
  "voice_input_match": {{ smartamp_voice_input_match | to_json }},
  "voice_capture_channel": {{ smartamp_voice_capture_channel | to_json }},
  "startup_volume_percent": {{ smartamp_startup_volume_percent | int }},
  "aec_reference": {
    "enabled": {{ smartamp_aec_reference_enabled | bool | to_json }},
    "sink_match": {{ smartamp_aec_reference_match | to_json }},
    "latency_ms": {{ smartamp_loopback_latency_ms | int }}
  },
  "background": {
    "enabled": {{ voice_ducking_enabled | to_json }},
    "sink_name": {{ smartamp_background_sink_name | to_json }},
    "latency_ms": {{ smartamp_loopback_latency_ms | int }},
    "duck_volume_percent": {{ smartamp_voice_duck_volume_percent | int }},
    "fade_ms": {{ smartamp_voice_duck_fade_ms | int }},
    "client_volume_percent": {{ smartamp_sendspin_volume_percent | int }}
  },
  "voice_bus": {
    "enabled": {{ voice_assistant_enabled | bool | to_json }},
    "sink_name": {{ smartamp_voice_sink_name | to_json }},
    "latency_ms": {{ smartamp_loopback_latency_ms | int }},
    "volume_percent": {{ smartamp_voice_startup_volume_percent | int }}
  },
  "resync_seconds": 900,
  "idle_teardown_seconds": {{ smartamp_idle_teardown_seconds | int }},
{# Only the routes this unit's hardware actually has. A board with no ADC has
     no capture device to bridge, and a unit with no USB gadget has no capture
     card at all, so neither gets a permanently unavailable source: the manager
     would otherwise keep a muted bridge wanted and never find a device for it,
     and the status file would report a route that cannot exist.

     This list is also what the Stream Deck greys out against. The manager
     rejects a command for a route it does not know, and publishes the names it
     does, so a key whose route is missing here draws unavailable and does
     nothing rather than pretending to switch something. Both may be absent -
     an Amp100 with the gadget off has no switchable input at all - so mind the
     commas below. #}
  "sources": {
{% set aux_route = smartamp_hifiberry_caps.aux_input | bool %}
{% set usb_route = usb_audio_gadget_enabled | bool %}
{% if aux_route %}
    "aux": {
      "match": {{ smartamp_aux_match | to_json }},
      "enabled": {{ smartamp_aux_enabled | bool | to_json }},
      "mute_when_off": true,
      "latency_ms": {{ smartamp_aux_latency_ms | int }},
      "volume_percent": {{ smartamp_aux_volume_percent | int }}
    }{{ ',' if usb_route else '' }}
{% endif %}
{% if usb_route %}
    "usb": {
      "match": {{ smartamp_usb_gadget_match | to_json }},
      "enabled": {{ smartamp_usb_enabled | bool | to_json }},
      "requires_usb_host": true,
      "target": {{ ('background' if voice_ducking_enabled else 'output') | to_json }},
      "latency_ms": {{ smartamp_loopback_latency_ms | int }},
      "volume_percent": {{ smartamp_usb_volume_percent | int }}
    }
{% endif %}
  }
}
