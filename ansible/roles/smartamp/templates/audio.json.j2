{% set voice_ducking_enabled = (voice_assistant_enabled | bool) and (smartamp_voice_ducking_enabled | bool) %}
{
  "output_match": {{ smartamp_output_match | to_json }},
  "startup_volume_percent": {{ smartamp_startup_volume_percent | int }},
{# The microphone the assistant hears through, as one section: the device, the
     channel published for it to record, and the echo reference the device is
     sent. Both ReSpeaker arrays fill all three from their boards.yml row; a
     plain microphone would set the channel null and the reference off. #}
  "microphone": {
    "match": {{ smartamp_voice_input_match | to_json }},
    "capture_channel": {{ smartamp_voice_capture_channel | to_json }},
    "echo_reference": {
      "enabled": {{ smartamp_aec_reference_enabled | bool | to_json }},
      "sink_match": {{ smartamp_aec_reference_match | to_json }},
      "latency_ms": {{ smartamp_loopback_latency_ms | int }}
    }
  },
{# The music bus. Every music input plays into it, and its own sink volume is
     the music level's public face - a real PipeWire control anything can read,
     write, and subscribe to, which is how a player watching its output device
     moves the room's level and is told when the dial or a USB host moved it.
     It exists whether or not the assistant ducks it; ducking is only something
     that happens to it. #}
  "background": {
    "enabled": true,
    "sink_name": {{ smartamp_background_sink_name | to_json }},
    "latency_ms": {{ smartamp_loopback_latency_ms | int }},
    "ducking_enabled": {{ voice_ducking_enabled | to_json }},
    "duck_volume_percent": {{ smartamp_voice_duck_volume_percent | int }},
    "fade_ms": {{ smartamp_voice_duck_fade_ms | int }},
    "client_volume_percent": {{ smartamp_sendspin_volume_percent | int }}
  },
  "voice_bus": {
    "enabled": {{ voice_assistant_enabled | bool | to_json }},
    "sink_name": {{ smartamp_voice_sink_name | to_json }},
    "latency_ms": {{ smartamp_loopback_latency_ms | int }},
    "volume_percent": {{ smartamp_voice_startup_volume_percent | int }}
  },
{# The amplifier's hardware ceiling, which the manager only ever reads: it is
     written once at boot by hifiberry-init.sh and is the speaker protection,
     not a day-to-day gain. Published so a control surface can show the level
     the speakers are actually driven at beside the ones it can move. #}
  "output_ceiling": {
    "card": {{ hifiberry_card_name | to_json }},
    "control": "Digital"
  },
  "resync_seconds": 900,
  "idle_teardown_seconds": {{ smartamp_idle_teardown_seconds | int }},
{# Local routes only. USB has its own client configuration and control socket. #}
  "sources": {
{% set aux_route = smartamp_hifiberry_caps.aux_input | bool %}
{% if aux_route %}
    "aux": {
      "match": {{ smartamp_aux_match | to_json }},
      "enabled": {{ smartamp_aux_enabled | bool | to_json }},
      "mute_when_off": true,
      "target": "background",
      "latency_ms": {{ smartamp_aux_latency_ms | int }},
      "volume_percent": {{ smartamp_aux_volume_percent | int }}
    }
{% endif %}
  }
}
