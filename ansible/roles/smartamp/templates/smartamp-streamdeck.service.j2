[Unit]
Description=Smart Amp Stream Deck+ controller
After=smartamp-audio-manager.service smartamp-voice-assistant.service
Wants=smartamp-voice-assistant.service
Requires=smartamp-audio-manager.service

[Service]
Type=simple
User={{ smartamp_service_user }}
Group={{ smartamp_service_user }}
Environment=NODE_ENV=production
Environment=SMARTAMP_CONFIG={{ smartamp_config_dir }}/streamdeck.json
Environment=XDG_RUNTIME_DIR=/run/user/{{ smartamp_uid }}
Environment=PULSE_SERVER=/run/user/{{ smartamp_uid }}/pulse/native
WorkingDirectory={{ smartamp_app_dir }}/streamdeck
ExecStart=/usr/bin/node {{ smartamp_app_dir }}/streamdeck/index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
