[Unit]
Description=Home Assistant Linux Voice Assistant
After=smartamp-audio-manager.service network-online.target
Requires=smartamp-audio-manager.service
Wants=network-online.target

[Service]
Type=simple
User={{ smartamp_service_user }}
Group={{ smartamp_service_user }}
SupplementaryGroups=audio
WorkingDirectory={{ smartamp_app_dir }}/linux-voice-assistant
Environment=HOME={{ smartamp_state_dir }}
Environment=XDG_RUNTIME_DIR=/run/user/{{ smartamp_uid }}
Environment=PULSE_SERVER=/run/user/{{ smartamp_uid }}/pulse/native
Environment=PYTHONUNBUFFERED=1
# Read by the launcher adapter's local endpointer. A silence of 0 disables it
# and leaves Home Assistant deciding when the speaker has finished.
Environment=SMARTAMP_ENDPOINT_SILENCE_MS={{ voice_assistant_endpoint_silence_ms }}
Environment=SMARTAMP_ENDPOINT_PATIENT_SILENCE_MS={{ voice_assistant_endpoint_patient_silence_ms }}
Environment=SMARTAMP_ENDPOINT_SHORT_PHRASE_MS={{ voice_assistant_endpoint_short_phrase_ms }}
Environment=SMARTAMP_ENDPOINT_MIN_SPEECH_MS={{ voice_assistant_endpoint_min_speech_ms }}
# The audio manager chooses the output defaults after discovering the
# HiFiBerry, and PipeWire's own configuration publishes the capture sources
# named here. Waiting for both avoids racing that first hardware scan.
ExecStartPre={{ smartamp_app_dir }}/wait-audio-ready.sh /run/user/{{ smartamp_uid }}/smartamp-audio-status.json 60 {{ smartamp_voice_input_name }}{% if smartamp_voice_capture_channel is not none %} {{ smartamp_voice_capture_name }}{% endif %}

# Capture is fixed at one channel: PipeWire publishes a mono default source
# (the array's ASR channel - 1 on the XVF3800, 0 on the ReSpeaker Lite - lifted
# by pipewire.conf.d/60-smartamp-voice-capture.conf, or the raw device when
# smartamp_voice_capture_channel is null). Never raise
# this to 2 here - LVA forwards a second channel to Home Assistant advertised
# as a far-end echo reference for server-side AEC, and neither array's other
# channel is one: the XVF3800's carries the voice itself and the Lite's a raw
# microphone, so HA would be told to cancel the speech against itself.
# Playback (TTS, timers, announcements, sounds) all goes through libmpv, which
# on mpv >= 0.36 prefers its native PipeWire output and ignores PULSE_SINK;
# --audio-output-device with the explicit mpv device name is what lands it on
# the audio manager's voice bus, whose bridge stream carries the voice volume.
ExecStart={{ smartamp_app_dir }}/linux-voice-assistant/.venv/bin/python {{ smartamp_app_dir }}/smartamp_lva.py \
  --name {{ voice_assistant_name | quote }} \
  --preferences-file {{ smartamp_state_dir }}/lva/configuration/preferences.json \
  --download-dir {{ smartamp_state_dir }}/lva/local \
  --wake-word-dir {{ smartamp_state_dir }}/lva/wakewords \
  --host 0.0.0.0 \
  --port {{ voice_assistant_port }} \
  --audio-input-channels 1 \
  --mic-volume {{ voice_assistant_mic_volume }} \
  --wake-model {{ voice_assistant_wake_model | quote }} \
  --stop-model {{ voice_assistant_stop_model | quote }} \
  --peripheral-host 127.0.0.1 \
  --peripheral-port {{ voice_assistant_peripheral_port }} \
  --peripheral-volume-step 0.05 \
  --audio-output-device pipewire/{{ smartamp_voice_sink_name }} \
{% if voice_assistant_debug | bool %}
  --debug \
{% endif %}
  --peripheral-startup-wait 5
Restart=always
RestartSec=5
TimeoutStartSec=75
TimeoutStopSec=20
# libmpv's native PipeWire output has its own realtime data thread. This
# system service does not inherit the grants on the smartamp user session.
LimitRTPRIO=95
LimitNICE=-20
Environment=DISABLE_RTKIT=1
# Apply a small, predictable isolation baseline without restricting the network
# discovery, ESPHome, and local PipeWire APIs used by voice features.
# ProtectHome=true would also hide /run/user, where the audio manager's status
# file and the PipeWire/PulseAudio sockets live; tmpfs mode allows BindPaths
# to mount the runtime directory back into the sandbox.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=tmpfs
BindPaths=/run/user/{{ smartamp_uid }}
ProtectSystem=full
UMask=0027

[Install]
WantedBy=multi-user.target
