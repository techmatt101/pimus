[Unit]
Description=Smart Amp Sendspin player
After=smartamp-audio-manager.service network-online.target
Wants=network-online.target
Requires=smartamp-audio-manager.service

[Service]
Type=simple
User={{ smartamp_service_user }}
Group={{ smartamp_service_user }}
Environment=XDG_RUNTIME_DIR=/run/user/{{ smartamp_uid }}
Environment=PULSE_SERVER=/run/user/{{ smartamp_uid }}/pulse/native
Environment=XDG_CONFIG_HOME={{ smartamp_state_dir }}/sendspin
{# The ALSA "pulse" output honours PULSE_SINK, which places playback on the
   music bus the audio manager maintains. That bus is also the default sink, so
   this only states what the client would resolve to anyway. #}
Environment=PULSE_SINK={{ smartamp_music_sink_name }}
{# --hardware-volume puts the client on the PulseAudio volume backend, which
   sets, reads, and subscribes to its output sink's volume and mute. With the
   music bus as the default sink that sink is the amp's music level, so Music
   Assistant's slider moves the room and the client reports the level back as
   its own player volume whenever the dial or a USB host moves it. Its MPRIS
   volume is a group command rather than a player one, so it is left alone. #}
ExecStart={{ smartamp_app_dir }}/sendspin/bin/sendspin daemon --name {{ sendspin_name | quote }} --audio-device pulse --hardware-volume true {{ ('--url ' + sendspin_server_url) if sendspin_server_url else '' }} {{ sendspin_extra_args }}
Restart=on-failure
RestartSec=3
# Apply a small, predictable isolation baseline without restricting the network
# and local PipeWire connections Sendspin needs for playback and discovery.
# ProtectHome=true would also hide /run/user, where the PipeWire/PulseAudio
# sockets live; tmpfs mode allows BindPaths to mount the runtime directory
# back into the sandbox.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=tmpfs
BindPaths=/run/user/{{ smartamp_uid }}
ProtectSystem=full
UMask=0027

[Install]
WantedBy=multi-user.target
