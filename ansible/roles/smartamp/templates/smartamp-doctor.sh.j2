#!/bin/sh
set -u

FAILED=0

heading() { printf '\n== %s ==\n' "$1"; }
pass() { printf 'PASS  %s\n' "$1"; }
warn() { printf 'WARN  %s\n' "$1"; }
fail() { printf 'FAIL  %s\n' "$1"; FAILED=1; }

heading 'Platform'
MODEL=$(tr -d '\000' < /proc/device-tree/model)
printf 'Model: %s\n' "$MODEL"
printf 'Kernel: %s\n' "$(uname -r)"
case "$MODEL" in *'Raspberry Pi 5'*) pass 'Raspberry Pi 5 detected' ;; *) fail 'Target is not a Raspberry Pi 5' ;; esac
if command -v vcgencmd >/dev/null 2>&1; then
    THROTTLED=$(vcgencmd get_throttled)
    [ "$THROTTLED" = 'throttled=0x0' ] && pass 'No under-voltage/throttle flags' || warn "$THROTTLED (check AAmp60 and USB power budget)"
fi

heading 'Memory'
free -h
swapon --show --noheadings || true
AVAILABLE_MB=$(awk '/^MemAvailable:/ { print int($2 / 1024) }' /proc/meminfo)
[ "$AVAILABLE_MB" -ge 150 ] && pass "${AVAILABLE_MB}MB available" || warn "Only ${AVAILABLE_MB}MB available; expect reclaim pressure"
{% if smartamp_zram_enabled %}
swapon --show=NAME --noheadings 2>/dev/null | grep -q '^/dev/zram0' \
    && pass 'Compressed RAM swap is active' \
    || fail 'zram is enabled but /dev/zram0 is not swapped on'
{% elif not smartamp_swapfile_enabled %}
swapon --show=NAME --noheadings 2>/dev/null | grep -q . \
    && warn 'Swap is active but none is configured' \
    || pass 'No swap configured and none active'
{% endif %}

heading 'ALSA hardware'
aplay -l || true
arecord -l || true
aplay -l 2>/dev/null | grep -q {{ hifiberry_card_name | quote }} && pass 'HiFiBerry playback found' || fail 'HiFiBerry playback missing'
arecord -l 2>/dev/null | grep -q {{ hifiberry_card_name | quote }} && pass 'HiFiBerry aux capture found' || fail 'HiFiBerry aux capture missing'
{% if voice_assistant_enabled or respeaker_led_enabled or smartamp_aec_reference_enabled %}
lsusb 2>/dev/null | grep -qi '2886:001a' && pass 'ReSpeaker XVF3800 connected' || fail 'Required ReSpeaker XVF3800 is not connected'
{% else %}
lsusb 2>/dev/null | grep -qi '2886:001a' && pass 'ReSpeaker XVF3800 connected' || warn 'Optional ReSpeaker XVF3800 is not connected'
{% endif %}
{% if streamdeck_enabled %}
lsusb 2>/dev/null | grep -qi '0fd9:0084' && pass 'Elgato Stream Deck+ connected' || fail 'Required Elgato Stream Deck+ is not connected'
{% else %}
lsusb 2>/dev/null | grep -qi '0fd9:0084' && pass 'Elgato Stream Deck+ connected' || warn 'Optional Elgato Stream Deck+ is not connected'
{% endif %}

heading 'PipeWire'
if runuser -u {{ smartamp_service_user | quote }} -- env XDG_RUNTIME_DIR=/run/user/{{ smartamp_uid }} PULSE_SERVER=/run/user/{{ smartamp_uid }}/pulse/native pactl info; then
    pass 'PipeWire Pulse is reachable'
else
    fail 'PipeWire Pulse is not reachable by {{ smartamp_service_user }}'
fi
STATUS_FILE=/run/user/{{ smartamp_uid }}/smartamp-audio-status.json
if [ -r "$STATUS_FILE" ] && jq -e 'type == "object"' "$STATUS_FILE" >/dev/null 2>&1; then
    jq . "$STATUS_FILE"
    jq -e '.sink | type == "string" and length > 0' "$STATUS_FILE" >/dev/null 2>&1 \
        && pass 'HiFiBerry is selected as the output sink' \
        || fail 'Audio status has no selected output sink'
{% if voice_assistant_enabled %}
    jq -e '.voice_input | type == "string" and length > 0' "$STATUS_FILE" >/dev/null 2>&1 \
        && pass 'ReSpeaker is selected as the voice input' \
        || fail 'Audio status has no selected voice input'
    jq -e '.voice_bus.available == true and (.voice_bus.sink | type == "string" and length > 0)' "$STATUS_FILE" >/dev/null 2>&1 \
        && pass 'Voice playback bus is available' \
        || fail 'Voice playback bus is unavailable'
{% endif %}
{% if voice_assistant_enabled and smartamp_voice_ducking_enabled %}
    jq -e '.background.available == true and (.background.sink | type == "string" and length > 0)' "$STATUS_FILE" >/dev/null 2>&1 \
        && pass 'Background ducking path is available' \
        || fail 'Background ducking path is unavailable'
{% endif %}
{% if smartamp_aec_reference_enabled %}
    jq -e '.aec_reference.available == true and (.aec_reference.sink | type == "string" and length > 0)' "$STATUS_FILE" >/dev/null 2>&1 \
        && pass 'ReSpeaker AEC reference path is available' \
        || fail 'ReSpeaker AEC reference path is unavailable'
{% endif %}
{% if smartamp_aux_enabled %}
    jq -e '.sources.aux.available == true' "$STATUS_FILE" >/dev/null 2>&1 \
        && pass 'Aux input source is available' \
        || fail 'Aux input source is unavailable'
{% endif %}
{% if usb_audio_gadget_enabled %}
    # "available" additionally requires the computer to be streaming right
    # now, so the durable health check is the capture node existing.
    jq -e '.sources.usb.node | type == "string" and length > 0' "$STATUS_FILE" >/dev/null 2>&1 \
        && pass 'USB gadget capture node is present' \
        || fail 'USB gadget capture node is missing'
{% endif %}
else
    fail 'Audio router status is missing or invalid JSON'
fi

heading 'Services'
{% set doctor_services = ['smartamp-hifiberry', 'smartamp-audio-manager'] + (['smartamp-usb-audio-gadget'] if usb_audio_gadget_enabled else []) + (['smartamp-sendspin'] if sendspin_enabled else []) + (['smartamp-voice-assistant'] if voice_assistant_enabled else []) %}
{% for service in doctor_services %}
systemctl is-active --quiet {{ service }}.service && pass '{{ service }} is active' || fail '{{ service }} is not active'
{% endfor %}
{% if smartamp_controller_enabled | bool %}
systemctl is-active --quiet smartamp-controller.service && pass 'smartamp-controller is active' || fail 'smartamp-controller is not active'
{% endif %}

heading 'Recent errors'
journalctl -p warning -b --no-pager -n 30 \
    -u smartamp-hifiberry \
    -u smartamp-audio-manager \
    -u smartamp-sendspin \
    -u smartamp-voice-assistant \
    -u smartamp-controller || true

exit "$FAILED"
