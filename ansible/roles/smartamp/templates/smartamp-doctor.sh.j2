#!/bin/sh
set -u

FAILED=0

heading() { printf '\n== %s ==\n' "$1"; }
pass() { printf 'PASS  %s\n' "$1"; }
warn() { printf 'WARN  %s\n' "$1"; }
fail() { printf 'FAIL  %s\n' "$1"; FAILED=1; }

heading 'Platform'
MODEL=$(tr -d '\000' < /proc/device-tree/model)
printf 'Model: %s\n' "$MODEL"
printf 'Kernel: %s\n' "$(uname -r)"
case "$MODEL" in
    *{{ smartamp_board_caps.model_match | quote }}*) pass '{{ smartamp_board_caps.label }} detected, provisioned as such' ;;
    *) fail 'Board is no longer the {{ smartamp_board_caps.label }} this was provisioned for' ;;
esac
if command -v vcgencmd >/dev/null 2>&1; then
    THROTTLED=$(vcgencmd get_throttled)
{# What is worth checking differs by board - a fixed USB-A budget on a Pi 4B, a
   mandatory self-powered hub on a Zero 2 W - so the hint comes from the board
   table rather than from a chain of conditions here. #}
    [ "$THROTTLED" = 'throttled=0x0' ] && pass 'No under-voltage/throttle flags' || warn "$THROTTLED ({{ smartamp_board_caps.power_hint }})"
fi

heading 'Memory'
free -h
swapon --show --noheadings || true
AVAILABLE_MB=$(awk '/^MemAvailable:/ { print int($2 / 1024) }' /proc/meminfo)
[ "$AVAILABLE_MB" -ge 150 ] && pass "${AVAILABLE_MB}MB available" || warn "Only ${AVAILABLE_MB}MB available; expect reclaim pressure"
{% if smartamp_zram_enabled %}
swapon --show=NAME --noheadings 2>/dev/null | grep -q '^/dev/zram0' \
    && pass 'Compressed RAM swap is active' \
    || fail 'zram is enabled but /dev/zram0 is not swapped on'
{% elif not smartamp_swapfile_enabled %}
swapon --show=NAME --noheadings 2>/dev/null | grep -q . \
    && warn 'Swap is active but none is configured' \
    || pass 'No swap configured and none active'
{% endif %}

heading 'ALSA hardware'
printf 'HiFiBerry board: %s\n' '{{ smartamp_hifiberry_caps.label }}'
aplay -l || true
arecord -l || true
aplay -l 2>/dev/null | grep -q {{ hifiberry_card_name | quote }} && pass '{{ smartamp_hifiberry_caps.label }} playback found' || fail '{{ smartamp_hifiberry_caps.label }} playback missing'
{# Read every playback channel: one correct channel cannot prove the ceiling holds.
   Only a channel line reads "<name>: Playback <raw> [<percent>%]"; the
   "Limits: Playback 0 - 207" line amixer prints above them carries no percent
   and must not count as a channel. The ceiling boots at the inventory value
   and the LEVELS page may move it from there, so an even reading elsewhere is
   a warning that names both, not a failure - but a WirePlumber folding the
   pinned sink volume onto the control shows up the same way, at 100%. #}
if ! DIGITAL=$(amixer -c {{ hifiberry_card_name | quote }} sget Digital 2>/dev/null); then
    fail 'HiFiBerry Digital control could not be read'
elif LEVEL=$(printf '%s\n' "$DIGITAL" | awk '
    /: Playback [0-9]+ \[/ {
        channels++
        if (!match($0, /\[[0-9]+%\]/)) {
            failed = 1
            next
        }
        level = substr($0, RSTART + 1, RLENGTH - 3) + 0
        if (channels > 1 && level != first) failed = 1
        first = level
    }
    END {
        if (channels == 0 || failed) exit 1
        print first
    }
'); then
    if [ "$LEVEL" -eq {{ hifiberry_output_volume_percent | int }} ]; then
        pass 'HiFiBerry hardware ceiling is holding at {{ hifiberry_output_volume_percent | int }}% on every playback channel'
    elif [ "$LEVEL" -ge 70 ]; then
        warn "HiFiBerry hardware ceiling reads ${LEVEL}% rather than the {{ hifiberry_output_volume_percent | int }}% it boots at: moved from the LEVELS page (a reboot restores it), or WirePlumber is on the control - check the soft-mixer rule"
    else
        fail "HiFiBerry hardware ceiling reads ${LEVEL}%, below the 70% floor the audio manager will set; something else moved the Digital control"
    fi
else
    fail 'HiFiBerry Digital playback channels are unreadable or uneven; check the soft-mixer rule and mixer state'
    printf '%s\n' "$DIGITAL"
fi
{% if smartamp_hifiberry_caps.aux_input | bool %}
arecord -l 2>/dev/null | grep -q {{ hifiberry_card_name | quote }} && pass 'HiFiBerry aux capture found' || fail 'HiFiBerry aux capture missing'
{% else %}
{# No ADC, so the card is playback-only by design; a capture device appearing
   would mean the wrong overlay loaded. #}
arecord -l 2>/dev/null | grep -q {{ hifiberry_card_name | quote }} && warn 'HiFiBerry reports a capture device, but this board has no ADC' || pass 'No HiFiBerry capture device, as expected for this board'
{% endif %}
{# The array is looked for by the USB ids of the one inventory names, so a unit
   configured for one array with the other plugged in fails here by name rather
   than as a voice assistant that never finds its microphone. #}
{% set respeaker_usb_id = smartamp_respeaker_caps.usb_vendor_id ~ ':' ~ smartamp_respeaker_caps.usb_product_id %}
{% if voice_assistant_enabled or respeaker_led_enabled or smartamp_aec_reference_enabled %}
lsusb 2>/dev/null | grep -qi {{ respeaker_usb_id | quote }} && pass {{ (smartamp_respeaker_caps.label ~ ' connected') | quote }} || fail {{ ('Required ' ~ smartamp_respeaker_caps.label ~ ' (' ~ respeaker_usb_id ~ ') is not connected') | quote }}
{% else %}
lsusb 2>/dev/null | grep -qi {{ respeaker_usb_id | quote }} && pass {{ (smartamp_respeaker_caps.label ~ ' connected') | quote }} || warn {{ ('Optional ' ~ smartamp_respeaker_caps.label ~ ' (' ~ respeaker_usb_id ~ ') is not connected') | quote }}
{% endif %}
{% if streamdeck_enabled %}
lsusb 2>/dev/null | grep -qi '0fd9:0084' && pass 'Elgato Stream Deck+ connected' || fail 'Required Elgato Stream Deck+ is not connected'
{% else %}
{# No deck by configuration, so its absence is the expected answer rather than
   something to warn about every run. One plugged in anyway is worth saying:
   nothing is deployed to drive it, which is why it stays dark. #}
lsusb 2>/dev/null | grep -qi '0fd9:0084' && warn 'An Elgato Stream Deck+ is connected, but streamdeck_enabled is off for this unit' || pass 'No Stream Deck, as configured'
{% endif %}
{% if streamdeck_enabled and smartamp_sleep_usb_power_off %}
{# The controller writes these to take the deck and ReSpeaker down in sleep, and
   Ansible grants the service account access to exactly this list. A path that
   is not there means the board enumerated a different topology than
   vars/boards.yml records, and sleep would silently save nothing. #}
for PORT in{% for port in smartamp_board_caps.usb_port_disables %} {{ port | quote }}{% endfor %}; do
    if [ ! -e "$PORT" ]; then
        fail "USB port control $PORT is missing; sleep cannot cut USB power"
    elif [ ! -w "$PORT" ]; then
        warn "USB port control $PORT is not writable by the service account"
    fi
done
{% if smartamp_board == 'pi4b' %}
{# Switching only works on VL805 firmware 000137ad or newer. Older firmware
   accepts the write and leaves the sockets powered, so print the version
   rather than let a silent no-op look like a working power cut. #}
rpi-eeprom-update 2>/dev/null | grep -i 'VL805\|CURRENT' | head -4 || true
printf 'VL805 firmware must be 000137ad or newer for USB power switching\n'
{% endif %}
{% endif %}

heading 'PipeWire'
smartamp_pactl() {
    runuser -u {{ smartamp_service_user | quote }} -- env XDG_RUNTIME_DIR=/run/user/{{ smartamp_uid }} PULSE_SERVER=/run/user/{{ smartamp_uid }}/pulse/native pactl "$@"
}
if smartamp_pactl info; then
    pass 'PipeWire Pulse is reachable'
else
    fail 'PipeWire Pulse is not reachable by {{ smartamp_service_user }}'
fi
{% if voice_assistant_enabled %}
{# The capture side is PipeWire's own configuration rather than the audio
   manager's, so it is read from the graph, not the status file: the array's
   capture node under the fixed name the loopback targets, the mono source that
   loopback publishes, and which of them the assistant resolves as the default. #}
{% set voice_default = smartamp_voice_capture_name if smartamp_voice_capture_channel is not none else smartamp_voice_input_name %}
SOURCES=$(smartamp_pactl list short sources 2>/dev/null | awk '{ print $2 }')
printf '%s\n' "$SOURCES" | grep -qxF {{ smartamp_voice_input_name | quote }} \
    && pass '{{ smartamp_respeaker_caps.label }} capture node is published as {{ smartamp_voice_input_name }}' \
    || fail '{{ smartamp_respeaker_caps.label }} capture node {{ smartamp_voice_input_name }} is missing: array unplugged, or its card is on a profile with no input'
{% if smartamp_voice_capture_channel is not none %}
printf '%s\n' "$SOURCES" | grep -qxF {{ smartamp_voice_capture_name | quote }} \
    && pass 'Voice capture source {{ smartamp_voice_capture_name }} is published' \
    || fail 'Voice capture source {{ smartamp_voice_capture_name }} is missing; PipeWire did not load 60-smartamp-voice-capture.conf'
{% endif %}
[ "$(smartamp_pactl get-default-source 2>/dev/null)" = {{ voice_default | quote }} ] \
    && pass 'Default source is {{ voice_default }}, which the voice assistant records' \
    || fail 'Default source is not {{ voice_default }}; the voice assistant is recording something else'
{% endif %}
STATUS_FILE=/run/user/{{ smartamp_uid }}/smartamp-audio-status.json
if [ -r "$STATUS_FILE" ] && jq -e 'type == "object"' "$STATUS_FILE" >/dev/null 2>&1; then
    jq . "$STATUS_FILE"
    jq -e '.sink | type == "string" and length > 0' "$STATUS_FILE" >/dev/null 2>&1 \
        && pass 'HiFiBerry is selected as the output sink' \
        || fail 'Audio status has no selected output sink'
{% if voice_assistant_enabled %}
    jq -e '(.idle == true or .voice_bus.available == true) and (.voice_bus.sink | type == "string" and length > 0)' "$STATUS_FILE" >/dev/null 2>&1 \
        && pass 'Voice playback bus is available' \
        || fail 'Voice playback bus is unavailable'
{% endif %}
{% if voice_assistant_enabled and smartamp_voice_ducking_enabled %}
    jq -e '(.idle == true or .music_bus.available == true) and (.music_bus.sink | type == "string" and length > 0)' "$STATUS_FILE" >/dev/null 2>&1 \
        && pass 'Music bus is available' \
        || fail 'Music bus is unavailable'
{% endif %}
{% if smartamp_aec_reference_enabled %}
    jq -e '(.aec_reference.available == true or (.idle == true and .aec_reference.endpoints_available == true)) and (.aec_reference.sink | type == "string" and length > 0)' "$STATUS_FILE" >/dev/null 2>&1 \
        && pass 'ReSpeaker AEC routing is ready or intentionally idle (cancellation not measured)' \
        || fail 'ReSpeaker AEC reference path is unavailable'
{% endif %}
{% if smartamp_aux_enabled %}
{# The aux stream is the inputs app's, and it drops the loopback while the
   manager reports the graph idle, so an idle amp has no aux stream on the bus
   by design; the device itself is checked from the inputs status below. #}
    jq -e '.sources.aux.available == true or .idle == true' "$STATUS_FILE" >/dev/null 2>&1 \
        && pass 'Aux input source is on the bus or intentionally idle' \
        || fail 'Aux input source has no stream on the music bus'
{% endif %}

else
    fail 'Audio router status is missing or invalid JSON'
fi

{% if smartamp_audio_inputs_enabled | bool %}
{# The inputs app publishes what it found of each input it was configured with.
   A missing node is the device, not the route: the route's own state (trim,
   toggle, whether a stream is on the bus) is the manager's, checked above. #}
heading 'Audio inputs'
INPUTS_STATUS_FILE=/run/user/{{ smartamp_uid }}/smartamp-audio-inputs-status.json
{% if usb_audio_gadget_enabled | bool %}
jq -e '.inputs.usb.node | type == "string" and length > 0' "$INPUTS_STATUS_FILE" >/dev/null 2>&1 \
    && pass 'USB gadget capture node is present' \
    || fail 'Audio inputs status or the USB gadget capture node is missing'
{% endif %}
{% if smartamp_hifiberry_caps.aux_input | bool %}
jq -e '.inputs.aux.node | type == "string" and length > 0' "$INPUTS_STATUS_FILE" >/dev/null 2>&1 \
    && pass 'Aux capture node is present' \
    || fail 'Audio inputs status or the aux capture node is missing'
{% endif %}
{% endif %}

heading 'Services'
{% set doctor_services = ['smartamp-hifiberry', 'smartamp-audio-manager'] + (['smartamp-usb-audio-gadget'] if usb_audio_gadget_enabled else []) + (['smartamp-audio-inputs'] if smartamp_audio_inputs_enabled | bool else []) + (['smartamp-sendspin'] if sendspin_enabled else []) + (['smartamp-voice-assistant'] if voice_assistant_enabled else []) %}
{% for service in doctor_services %}
systemctl is-active --quiet {{ service }}.service && pass '{{ service }} is active' || fail '{{ service }} is not active'
{% endfor %}
{% if smartamp_controller_enabled | bool %}
systemctl is-active --quiet smartamp-controller.service && pass 'smartamp-controller is active' || fail 'smartamp-controller is not active'
{% endif %}

heading 'Recent errors'
journalctl -p warning -b --no-pager -n 30 \
    -u smartamp-hifiberry \
    -u smartamp-audio-manager \
    -u smartamp-audio-inputs \
    -u smartamp-sendspin \
    -u smartamp-voice-assistant \
    -u smartamp-controller || true

exit "$FAILED"
