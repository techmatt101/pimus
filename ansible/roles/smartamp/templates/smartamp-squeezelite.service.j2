[Unit]
Description=Smart Amp Squeezelite player
After=smartamp-audio-manager.service network-online.target
Wants=network-online.target
Requires=smartamp-audio-manager.service

[Service]
Type=simple
User={{ smartamp_service_user }}
Group={{ smartamp_service_user }}
Environment=XDG_RUNTIME_DIR=/run/user/{{ smartamp_uid }}
Environment=PULSE_SERVER=/run/user/{{ smartamp_uid }}/pulse/native
{% if (voice_assistant_enabled | bool) and (smartamp_voice_ducking_enabled | bool) %}
Environment=PULSE_SINK={{ smartamp_background_sink_name }}
{% endif %}
ExecStart=/usr/bin/squeezelite -n {{ squeezelite_name | quote }} -o pulse {{ ('-s ' + squeezelite_server) if squeezelite_server else '' }} {{ squeezelite_extra_args }}
Restart=on-failure
RestartSec=3
# Squeezelite only needs its network connection and the PipeWire Unix socket;
# it has no persistent files to change on this endpoint.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ smartamp_state_dir }} /run/user/{{ smartamp_uid }}
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
