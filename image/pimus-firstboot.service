[Unit]
Description=Provision the Pimus Smart Amp on first boot
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/pimus/provisioned

[Service]
Type=oneshot
ExecStart=/opt/pimus/image/run-firstboot.sh
Restart=on-failure
RestartSec=30
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
